# Flutter Web n'utilise pas VITE_API_URL directement.
# Configure cette variable dans Netlify, puis le build l'injecte avec --dart-define.
API_BASE_URL=https://solola-backend.onrender.com

# Alias documentaire si tu migres un jour vers Vite/React.
VITE_API_URL=https://solola-backend.onrender.com


# Couche frontend Firebase Authentication pour la vérification email.
# Mets FIREBASE_AUTH_ENABLED=true seulement après avoir créé ton projet Firebase
# et activé le fournisseur Email/Password dans Firebase Authentication.
FIREBASE_AUTH_ENABLED=false
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
